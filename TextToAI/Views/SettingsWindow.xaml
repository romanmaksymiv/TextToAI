<Window x:Class="TextToAI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TextToAI Settings"
        Height="560" Width="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="Gray"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0" Margin="0,0,0,15">

            <!-- ============ Provider ============ -->
            <TabItem Header="Provider">
                <StackPanel Margin="15">

                    <!-- Provider -->
                    <TextBlock Text="Provider" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="ProviderComboBox" Padding="5" SelectionChanged="Provider_Changed"/>

                    <!-- API Key -->
                    <TextBlock x:Name="ApiKeyLabel" Text="API Key" Style="{StaticResource FieldLabel}" Margin="0,15,0,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyPasswordBox" Grid.Column="0" Padding="5"/>
                        <TextBox x:Name="ApiKeyTextBox" Grid.Column="0" Padding="5" Visibility="Collapsed"/>
                        <Button x:Name="ToggleApiKeyButton" Grid.Column="1" Content="Show" Width="50" Margin="5,0,0,0" Click="ToggleApiKeyVisibility_Click"/>
                    </Grid>
                    <TextBlock x:Name="ApiKeyHint" Style="{StaticResource HintText}"/>

                    <!-- Model -->
                    <TextBlock Text="Model" Style="{StaticResource FieldLabel}" Margin="0,15,0,5"/>
                    <ComboBox x:Name="ModelComboBox" Padding="5" IsEditable="True"/>
                    <TextBlock Text="Pick a preset or type any model name your provider supports."
                               Style="{StaticResource HintText}"/>
                </StackPanel>
            </TabItem>

            <!-- ============ Hotkeys ============ -->
            <TabItem Header="Hotkeys">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">

                        <!-- Action 1 -->
                        <GroupBox Header="Action 1" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="Hotkey1TextBox" Grid.Column="0" Padding="5" IsReadOnly="True"/>
                                    <Button x:Name="RecordHotkey1Button" Grid.Column="1" Content="Record" Width="60" Margin="5,0,0,0" Click="RecordHotkey_Click"/>
                                </Grid>

                                <TextBlock Text="Prompt (use {text} as placeholder)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                <TextBox x:Name="Prompt1TextBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="90"
                                         Padding="5"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Action 2 -->
                        <GroupBox Header="Action 2" Padding="10" Margin="0,15,0,0">
                            <StackPanel>
                                <TextBlock Text="Hotkey" Style="{StaticResource FieldLabel}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="Hotkey2TextBox" Grid.Column="0" Padding="5" IsReadOnly="True"/>
                                    <Button x:Name="RecordHotkey2Button" Grid.Column="1" Content="Record" Width="60" Margin="5,0,0,0" Click="RecordHotkey_Click"/>
                                    <Button x:Name="ClearHotkey2Button" Grid.Column="2" Content="Clear" Width="50" Margin="5,0,0,0" Click="ClearHotkey2_Click"/>
                                </Grid>

                                <TextBlock Text="Prompt (use {text} as placeholder)" Style="{StaticResource FieldLabel}" Margin="0,12,0,5"/>
                                <TextBox x:Name="Prompt2TextBox"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Height="90"
                                         Padding="5"/>
                                <TextBlock Text="Clear the hotkey to disable this action."
                                           Style="{StaticResource HintText}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Start with Windows -->
        <CheckBox x:Name="StartWithWindowsCheckBox" Grid.Row="1"
                  Content="Start with Windows" Margin="0,0,0,15"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Content="Save" Width="80" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
